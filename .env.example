# Copy to ".env" and fill in. Never commit .env or share the key.
# Any OpenAI-compatible provider works. Check your provider's console for current model names.

# Groq (default)
LLM_API_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# Google Gemini instead:
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# Seconds to pause between calls (raise it if you hit rate limits)
LLM_DELAY=2
